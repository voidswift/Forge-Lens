# Copy to apps/web/.env.local and fill in. Never commit real secrets.

# --- Database (required) ---
# Local default matches docker-compose.yml. Production: Neon/Supabase connection string.
DATABASE_URL=postgres://forgelens:forgelens@localhost:5432/forgelens

# 32-character secret used to encrypt stored GitHub tokens (AES-256-GCM). Required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
DB_ENCRYPTION_KEY=

# --- Clerk auth (required for sign-in) --- https://dashboard.clerk.com -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk dashboard -> Webhooks -> your endpoint -> Signing Secret (needed for /api/webhooks/clerk)
CLERK_WEBHOOK_SECRET=

# --- GitHub ---
# Server-side token for PUBLIC repos only (showcase seed + public-repo fallback).
# https://github.com/settings/tokens -> fine-grained, "Public repositories (read-only)".
GITHUB_TOKEN=
# Any random string; must match the secret configured on your GitHub webhook.
GITHUB_WEBHOOK_SECRET=

# --- Inngest --- https://app.inngest.com (not needed locally: run `npx inngest-cli dev`)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Ingestion caps (optional; defaults shown) ---
INGEST_MAX_MONTHS=12
INGEST_MAX_ITEMS=5000

# --- Optional ---
# Enables the AI Insights page. Leave empty to hide it.
OPENAI_API_KEY=
# Public base URL, used in badge Markdown. Defaults to the request host.
NEXT_PUBLIC_APP_URL=
